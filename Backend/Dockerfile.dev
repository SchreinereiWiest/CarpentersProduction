# =========================================
# Application / Engine
# =========================================

>>>>>>> bffc5fb (dockerfile change)
COPY --from=engine . /Engine
COPY . .

# =========================================
# Non-Root Permissions
# =========================================

# Kubernetes verwendet UID/GID 33.
# Die Anwendung inklusive Prisma und Engine
# muss für diesen Benutzer lesbar sein.

RUN chown -R 33:33 /app /Engine \
    && chmod 755 /app /Engine

# Temporäre Pfade für pnpm / Node.js
ENV HOME=/tmp
ENV TMPDIR=/tmp
ENV XDG_CACHE_HOME=/tmp/.cache
ENV NODE_ENV=production

# =========================================
# Security
# =========================================

# Ab hier keine Root-Rechte mehr
USER 33:33

# =========================================
# Runtime
# =========================================

EXPOSE 5000

CMD ["pnpm", "run", "start"]
