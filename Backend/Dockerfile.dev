# =========================================
# Stage: Development (Node.js Backend)
# =========================================

ARG NODE_VERSION=22.22.2

FROM node:${NODE_VERSION} AS dev

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install

# Copy Prisma schema first
COPY prisma ./prisma

# Generate Prisma Client from current schema
RUN npx prisma generate

# Copy application source
COPY . .

# Ensure node user owns application files
RUN chown -R node:node /app

# Use non-root user
USER node

# Backend port
EXPOSE 5000

CMD ["npm", "run", "dev"]