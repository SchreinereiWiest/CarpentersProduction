# PostgreSQL im Docker-Compose-Netzwerk
NODE_ENV=development
DATABASE_URL=postgresql://carpenters:CHANGE_ME@postgres:5432/carpentersproduction

# Mit `openssl rand -hex 32` jeweils einen eigenen Wert erzeugen.
JWT_ACCESS_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME

# 32-Byte-Schlüssel (64 Hex-Zeichen) für mandantenbezogene AI-Zugangsdaten.
# Mit `openssl rand -hex 32` erzeugen und nach Inbetriebnahme sicher sichern.
AI_SECRET_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS

# Mandant und austauschbare Lizenzquelle
BOOTSTRAP_TENANT_SLUG=development
DEVELOPMENT_TENANT_NAME=development
# development = lokale Entwicklungslizenz; database = signiertes Offline-Zertifikat;
# remote = serverseitige API-Anbindung an MoebelDesignLicencing
LICENSE_PROVIDER=development
LICENSE_CACHE_TTL_MS=300000
# Für LICENSE_PROVIDER=database: PEM Public Key, Zeilenumbrüche dürfen als \\n gespeichert sein.
LICENSE_PUBLIC_KEY=
# Für LICENSE_PROVIDER=remote. In Produktion ist HTTPS verpflichtend.
LICENSE_SERVER_URL=http://licensing-api:5100/
LICENSE_SERVER_API_KEY=
LICENSE_SERVER_PRODUCT_ID=carpenters-production
LICENSE_SERVER_TIMEOUT_MS=5000

# Kommagetrennte, vollständige Origins inklusive Schema (kein abschließender Slash)
ALLOWED_ORIGINS=http://localhost:5173,http://10.10.100.52,https://cp.moebelschreinerei-wiest.de

# Garage/S3
S3_ENDPOINT=http://garage:3900
S3_PUBLIC_ENDPOINT=http://10.10.100.52/carpenters-storage
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET=carpenters-storage

# Interner OCR-Jobdienst (denselben zufälligen Wert im Worker verwenden)
VALKEY_URL=redis://valkey:6379/0
MEASUREMENT_OCR_SECRET=CHANGE_ME_RANDOM_64_HEX_CHARS
MEASUREMENT_OCR_RESOLVE_URL=http://backendjs:5000/api/internal/measurement-ocr/resolve
MEASUREMENT_OCR_CALLBACK_URL=http://backendjs:5000/api/internal/measurement-ocr/result
MEASUREMENT_OCR_MAX_PAGES=50

# Optionale einmalige Bootstrap-Konten
BOOTSTRAP_ADMIN_EMAIL=admin@example.invalid
BOOTSTRAP_ADMIN_LOGIN=admin
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_MINIMUM_12_CHARS
BOOTSTRAP_USER_EMAIL=user@example.invalid
BOOTSTRAP_USER_LOGIN=user
BOOTSTRAP_USER_PASSWORD=CHANGE_ME_MINIMUM_12_CHARS
