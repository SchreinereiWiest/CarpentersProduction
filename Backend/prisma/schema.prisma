generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}



enum UserRole {
  admin
  manager
  user
}

enum CustomerStatus {
  lead
  active
  inactive
}



model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole @default(user)
  isActive     Boolean  @default(true) @map("is_active")

  customersCreated Customer[] @relation("CustomerCreatedBy")
  projectsCreated  Project[]  @relation("ProjectCreatedBy")

  communications Communication[]
  appointments   Appointment[]
  files          File[]

  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  @@map("users")
}



model Customer {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerNumber  String?  @unique @map("customer_number")

  firstName       String? @map("first_name")
  lastName        String? @map("last_name")
  companyName     String? @map("company_name")

  email           String?
  phoneMobile     String? @map("phone_mobile")
  phoneLandline   String? @map("phone_landline")

  preferredContact String? @map("preferred_contact")

  newsletterOptIn    Boolean   @default(false) @map("newsletter_opt_in")
  newsletterOptInAt  DateTime? @map("newsletter_opt_in_at")

  customerStatus  CustomerStatus @default(lead) @map("customer_status")
  customerRating  Int @default(0) @db.SmallInt @map("customer_rating")

  source String?
  notes  String?

  createdById String? @db.Uuid @map("created_by")
  createdBy   User?   @relation("CustomerCreatedBy", fields: [createdById], references: [id])

  projects   Project[]
  addresses  CustomerAddress[]
  communications Communication[]
  appointments   Appointment[]
  files      File[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("customers")
}



model CustomerAddress {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  customerId  String @db.Uuid @map("customer_id")
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  type String

  street      String?
  houseNumber String? @map("house_number")
  postalCode  String? @map("postal_code")
  city        String?
  country     String?

  floor             String?
  elevatorAvailable Boolean @default(false) @map("elevator_available")
  parkingInfo       String? @map("parking_info")

  appointments Appointment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("customer_addresses")
}



model Project {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  customerId    String @db.Uuid @map("customer_id")
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  projectNumber String? @unique @map("project_number")

  title       String
  description String?

  projectType String? @map("project_type")
  status      String   @default("inquiry")
  priority    String   @default("normal")

  estimatedValue Float? @map("estimated_value")
  finalValue     Float? @map("final_value")

  startDate        DateTime? @map("start_date")
  installationDate DateTime? @map("installation_date")
  completionDate   DateTime? @map("completion_date")

  specialRequirements String? @map("special_requirements")
  customerNotes       String? @map("customer_notes")
  internalNotes       String? @map("internal_notes")

  createdById String? @db.Uuid @map("created_by")
  createdBy   User?   @relation("ProjectCreatedBy", fields: [createdById], references: [id])

  communications Communication[]
  appointments   Appointment[]
  files          File[]
  storage        ProjectStorage[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("projects")
}



model Communication {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  customerId String @db.Uuid @map("customer_id")
  projectId  String? @db.Uuid @map("project_id")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  project  Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  type    String
  subject String?
  content String

  followUpDate DateTime? @map("follow_up_date")

  createdById String? @db.Uuid @map("created_by")
  createdBy   User? @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("communications")
}



model Appointment {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  customerId String @db.Uuid @map("customer_id")
  projectId  String? @db.Uuid @map("project_id")
  addressId  String? @db.Uuid @map("address_id")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  project  Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  address  CustomerAddress? @relation(fields: [addressId], references: [id], onDelete: SetNull)

  appointmentType String? @map("appointment_type")
  title           String?
  description     String?

  startAt DateTime @map("start_at")
  endAt   DateTime @map("end_at")

  status String @default("planned")

  createdById String? @db.Uuid @map("created_by")
  createdBy   User? @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("appointments")
}



model S3Object {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  provider    String
  bucketName  String @map("bucket_name")
  objectKey   String @map("object_key")

  region  String?
  endpoint String?

  accessUrl String? @map("access_url")
  etag      String?

  storageClass String? @map("storage_class")
  isArchived   Boolean @default(false) @map("is_archived")

  files File[]
  projectStorage ProjectStorage[]

  uploadedAt DateTime @default(now()) @map("uploaded_at")

  @@map("s3_objects")
}



model File {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  customerId String? @db.Uuid @map("customer_id")
  projectId  String? @db.Uuid @map("project_id")

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  project  Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  storageObjectId String @db.Uuid @map("storage_object_id")
  storageObject    S3Object @relation(fields: [storageObjectId], references: [id], onDelete: Cascade)

  fileName     String @map("file_name")
  originalName String? @map("original_name")

  mimeType String? @map("mime_type")
  fileSize Int?    @map("file_size")

  category String?

  uploadedById String? @db.Uuid @map("uploaded_by")
  uploadedBy   User? @relation(fields: [uploadedById], references: [id])

  uploadedAt DateTime @default(now()) @map("uploaded_at")
  deletedAt   DateTime? @map("deleted_at")

  @@map("files")
}



model ProjectStorage {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  projectId String @db.Uuid @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  storageObjectId String @db.Uuid @map("storage_object_id")
  storageObject   S3Object @relation(fields: [storageObjectId], references: [id], onDelete: Cascade)

  dataType String? @map("data_type")
  schemaVersion String? @map("schema_version")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("project_storage")
}