generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  manager
  user
}

enum CustomerStatus {
  lead
  active
  inactive
}

enum WorkType {
  cutting
  edging
  cnc
  assembly
  finishing
  installation
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole @default(user)
  isActive     Boolean  @default(true) @map("is_active")

  customersCreated Customer[] @relation("CustomerCreatedBy")
  projectsCreated  Project[]  @relation("ProjectCreatedBy")

  communications Communication[]
  appointments   Appointment[]
  files          File[]
  timeTable TimeEntry[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("users")
}

model Customer {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerNumber String? @unique @map("customer_number")

  firstName   String? @map("first_name")
  lastName    String? @map("last_name")
  companyName String? @map("company_name")

  email         String?
  phoneMobile   String? @map("phone_mobile")
  phoneLandline String? @map("phone_landline")

  preferredContact String? @map("preferred_contact")

  newsletterOptIn   Boolean   @default(false) @map("newsletter_opt_in")
  newsletterOptInAt DateTime? @map("newsletter_opt_in_at")

  customerStatus CustomerStatus @default(lead) @map("customer_status")
  customerRating Int            @default(0) @map("customer_rating") @db.SmallInt

  source String?
  notes  String?

  createdById String? @map("created_by") @db.Uuid
  createdBy   User?   @relation("CustomerCreatedBy", fields: [createdById], references: [id])

  projects       Project[]
  addresses      CustomerAddress[]
  communications Communication[]
  appointments   Appointment[]
  files          File[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("customers")
}

model CustomerAddress {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  customerId String   @map("customer_id") @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  street      String?
  houseNumber String? @map("house_number")
  postalCode  String? @map("postal_code")
  city        String?
  country     String?

  floor             String?
  elevatorAvailable Boolean @default(false) @map("elevator_available")
  parkingInfo       String? @map("parking_info")

  appointments Appointment[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("customer_addresses")
}

model Project {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  customerId String   @map("customer_id") @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  projectNumber String? @unique @map("project_number")

  title       String
  description String?

  projectType String? @map("project_type")
  status      String  @default("inquiry")
  priority    String  @default("normal")

  estimatedValue Float? @map("estimated_value")
  finalValue     Float? @map("final_value")

  startDate        DateTime? @map("start_date")
  installationDate DateTime? @map("installation_date")
    completionDate   DateTime? @map("completion_date")

  specialRequirements String? @map("special_requirements")
  customerNotes       String? @map("customer_notes")
  internalNotes       String? @map("internal_notes")

  createdById String? @map("created_by") @db.Uuid
  createdBy   User?   @relation("ProjectCreatedBy", fields: [createdById], references: [id])

  communications Communication[]
  appointments   Appointment[]
  files          File[]
  storage        ProjectStorage[]
  timeEntries    TimeEntry[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("projects")
  
}

model Communication {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  customerId String  @map("customer_id") @db.Uuid
  projectId  String? @map("project_id") @db.Uuid

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  project  Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  type    String
  subject String?
  content String

  followUpDate DateTime? @map("follow_up_date")

  createdById String? @map("created_by") @db.Uuid
  createdBy   User?   @relation(fields: [createdById], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("communications")
}

model Appointment {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  customerId String  @map("customer_id") @db.Uuid
  projectId  String? @map("project_id") @db.Uuid
  addressId  String? @map("address_id") @db.Uuid

  customer Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  project  Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  address  CustomerAddress? @relation(fields: [addressId], references: [id], onDelete: SetNull)

  appointmentType String? @map("appointment_type")
  title           String?
  description     String?

  startAt DateTime @map("start_at")
  endAt   DateTime @map("end_at")

  status String @default("planned")

  createdById String? @map("created_by") @db.Uuid
  createdBy   User?   @relation(fields: [createdById], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("appointments")
}

model S3Object {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  provider   String
  bucketName String @map("bucket_name")
  objectKey  String @map("object_key")

  region   String?
  endpoint String?

  accessUrl String? @map("access_url")
  etag      String?

  storageClass String? @map("storage_class")
  isArchived   Boolean @default(false) @map("is_archived")

  files          File[]
  projectStorage ProjectStorage[]

  uploadedAt DateTime @default(now()) @map("uploaded_at")

  @@map("s3_objects")
}

model File {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  customerId String? @map("customer_id") @db.Uuid
  projectId  String? @map("project_id") @db.Uuid

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  project  Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  storageObjectId String   @map("storage_object_id") @db.Uuid
  storageObject   S3Object @relation(fields: [storageObjectId], references: [id], onDelete: Cascade)

  fileName     String  @map("file_name")
  originalName String? @map("original_name")

  mimeType String? @map("mime_type")
  fileSize Int?    @map("file_size")

  category String?

  uploadedById String? @map("uploaded_by") @db.Uuid
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id])

  uploadedAt DateTime  @default(now()) @map("uploaded_at")
  deletedAt  DateTime? @map("deleted_at")

  status String? @map("status")

  @@map("files")
}

model ProjectStorage {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  projectId String  @map("project_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  storageObjectId String   @map("storage_object_id") @db.Uuid
  storageObject   S3Object @relation(fields: [storageObjectId], references: [id], onDelete: Cascade)

  dataType      String? @map("data_type")
  schemaVersion String? @map("schema_version")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("project_storage")
}


model Material {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  materialNumber String? @map("material_number")
  name           String  @map("name")
  manufacturer   String? @map("manufacturer")

  width Int @map("width")

  height Int @map("height")

  category String? @map("category")

  thickness Float? @map("thickness")

  pricePerSquareMeter Decimal? @map("price_per_square_meter") @db.Decimal(10, 2)

  quantity Int? @map("quantity")

  minimumStorage Int? @map("minimum_storage")

  maser Boolean? @default(false) @map("maser")

  supplier String? @map("supplier")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([materialNumber])
  @@index([name])
  @@map("materials")
}


model TimeEntry {

  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  projectId String @map("project_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  userId String? @map("user_id") @db.Uuid
  user   User? @relation(fields: [userId], references: [id])

  workType WorkType @map("work_type")

  startedAt DateTime? @map("started_at")
  endedAt DateTime? @map("ended_at")

  duration Int @default(0) // Sekunden

  note String?

  createdAt DateTime @default(now()) @map("created_at")

  @@map("time_entries")
}