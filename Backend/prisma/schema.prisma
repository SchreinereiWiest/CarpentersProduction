generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  manager
  user
}

enum CustomerStatus {
  lead
  active
  inactive
}

model User {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  firstName String? @map("first_name")
  lastName  String? @map("last_name")
  email     String  @unique

  login        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole @default(user)
  isActive     Boolean  @default(true) @map("is_active")
  authVersion  Int      @default(0) @map("auth_version")

  customersCreated Customer[] @relation("CustomerCreatedBy")
  projectsCreated  Project[]  @relation("ProjectCreatedBy")

  communications Communication[]
  appointments   Appointment[]
  files          File[]
  timeTable      TimeEntry[]
  auditLogs      AuditLog[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("users")
}

model AuditLog {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  actorUserId String? @map("actor_user_id") @db.Uuid
  actorUser   User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  action     String
  entityType String  @map("entity_type")
  entityId   String? @map("entity_id")
  metadata   Json?
  ipAddress  String? @map("ip_address")
  userAgent  String? @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([actorUserId])
  @@index([action, entityType])
  @@map("audit_logs")
}

model StorageDeletionJob {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  bucketName String  @map("bucket_name")
  objectKey  String  @map("object_key")
  status     String  @default("pending")
  attempts   Int     @default(0)
  lastError  String? @map("last_error")

  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at")
  completedAt   DateTime? @map("completed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@unique([bucketName, objectKey])
  @@index([status, nextAttemptAt])
  @@map("storage_deletion_jobs")
}

model Customer {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerNumber String? @unique @map("customer_number")

  firstName   String? @map("first_name")
  lastName    String? @map("last_name")
  companyName String? @map("company_name")

  email         String?
  phoneMobile   String? @map("phone_mobile")
  phoneLandline String? @map("phone_landline")

  preferredContact String? @map("preferred_contact")

  newsletterOptIn   Boolean   @default(false) @map("newsletter_opt_in")
  newsletterOptInAt DateTime? @map("newsletter_opt_in_at")

  customerStatus CustomerStatus @default(lead) @map("customer_status")
  customerRating Int            @default(0) @map("customer_rating") @db.SmallInt

  source String?
  notes  String?

  createdById String? @map("created_by") @db.Uuid
  createdBy   User?   @relation("CustomerCreatedBy", fields: [createdById], references: [id])

  projects       Project[]
  addresses      CustomerAddress[]
  communications Communication[]
  appointments   Appointment[]
  files          File[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("customers")
}

model CustomerAddress {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  customerId String   @map("customer_id") @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  street      String?
  houseNumber String? @map("house_number")
  postalCode  String? @map("postal_code")
  city        String?
  country     String?

  floor             String?
  elevatorAvailable Boolean @default(false) @map("elevator_available")
  parkingInfo       String? @map("parking_info")

  appointments Appointment[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("customer_addresses")
}

model Project {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  customerId String   @map("customer_id") @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  projectNumber String? @unique @map("project_number")

  title       String
  description String?

  projectType String? @map("project_type")
  status      String  @default("active")
  priority    String  @default("normal")

  estimatedValue Float? @map("estimated_value")
  finalValue     Float? @map("final_value")

  startDate        DateTime? @map("start_date")
  installationDate DateTime? @map("installation_date")
  completionDate   DateTime? @map("completion_date")

  specialRequirements String? @map("special_requirements")
  customerNotes       String? @map("customer_notes")
  internalNotes       String? @map("internal_notes")

  createdById String? @map("created_by") @db.Uuid
  createdBy   User?   @relation("ProjectCreatedBy", fields: [createdById], references: [id])

  communications Communication[]
  appointments   Appointment[]
  files          File[]
  storage        ProjectStorage[]
  timeEntries    TimeEntry[]
  managementTransactions ManagementTransaction[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("projects")
}

model Communication {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  customerId String  @map("customer_id") @db.Uuid
  projectId  String? @map("project_id") @db.Uuid

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  project  Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  type    String
  subject String?
  content String

  followUpDate DateTime? @map("follow_up_date")

  createdById String? @map("created_by") @db.Uuid
  createdBy   User?   @relation(fields: [createdById], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("communications")
}

model Appointment {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  customerId String  @map("customer_id") @db.Uuid
  projectId  String? @map("project_id") @db.Uuid
  addressId  String? @map("address_id") @db.Uuid

  customer Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  project  Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  address  CustomerAddress? @relation(fields: [addressId], references: [id], onDelete: SetNull)

  appointmentType String? @map("appointment_type")
  title           String?
  description     String?

  startAt DateTime @map("start_at")
  endAt   DateTime @map("end_at")

  status String @default("planned")

  createdById String? @map("created_by") @db.Uuid
  createdBy   User?   @relation(fields: [createdById], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("appointments")
}

model S3Object {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  provider   String
  bucketName String @map("bucket_name")
  objectKey  String @map("object_key")

  region   String?
  endpoint String?

  accessUrl String? @map("access_url")
  etag      String?

  storageClass String? @map("storage_class")
  isArchived   Boolean @default(false) @map("is_archived")

  files          File[]
  projectStorage ProjectStorage[]

  uploadedAt DateTime @default(now()) @map("uploaded_at")

  @@map("s3_objects")
}

model File {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  customerId String? @map("customer_id") @db.Uuid
  projectId  String? @map("project_id") @db.Uuid

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  project  Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  storageObjectId String   @map("storage_object_id") @db.Uuid
  storageObject   S3Object @relation(fields: [storageObjectId], references: [id], onDelete: Cascade)

  fileName     String  @map("file_name")
  originalName String? @map("original_name")

  mimeType String? @map("mime_type")
  fileSize Int?    @map("file_size")

  category String?

  uploadedById String? @map("uploaded_by") @db.Uuid
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id])

  uploadedAt DateTime  @default(now()) @map("uploaded_at")
  deletedAt  DateTime? @map("deleted_at")

  status String? @map("status")

  shopArticles ShopArticle[] @relation("ShopArticleImage")
  managementTransactions ManagementTransaction[]

  @@map("files")
}

model ProjectStorage {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  projectId String  @map("project_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  storageObjectId String   @map("storage_object_id") @db.Uuid
  storageObject   S3Object @relation(fields: [storageObjectId], references: [id], onDelete: Cascade)

  dataType      String? @map("data_type")
  schemaVersion String? @map("schema_version")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("project_storage")
}

model Material {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  materialNumber String? @map("material_number")
  name           String  @map("name")
  manufacturer   String? @map("manufacturer")

  width Int @map("width")

  height Int @map("height")

  category String? @map("category")

  thickness Float? @map("thickness")

  pricePerSquareMeter Decimal? @map("price_per_square_meter") @db.Decimal(10, 2)

  quantity Int? @map("quantity")

  minimumStorage Int? @map("minimum_storage")

  maser Boolean? @default(false) @map("maser")

  supplierId String?   @map("supplier_id") @db.Uuid
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([materialNumber])
  @@index([name])
  @@map("materials")
}

model Supplier {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  name       String
  externalId String? @map("external_id")

  // Für spätere IDS-Connect-/E-Procurement-Adapter. Zugangsdaten gehören nicht in dieses JSON.
  procurementType   String? @map("procurement_type")
  procurementConfig Json?   @map("procurement_config")

  articles  ShopArticle[]
  materials Material[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([name])
  @@map("suppliers")
}

model ShopArticleGroup {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  name        String
  description String?
  articles    ShopArticle[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([name])
  @@map("shop_article_groups")
}

model ShopArticle {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  name        String
  sku         String?
  category    String?
  description String?
  unit        String  @default("Stk.")
  netPrice    Decimal @default(0) @map("net_price") @db.Decimal(12, 2)

  supplierId String?   @map("supplier_id") @db.Uuid
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  groupId String?           @map("group_id") @db.Uuid
  group   ShopArticleGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  imageFileId String? @map("image_file_id") @db.Uuid
  imageFile   File?   @relation("ShopArticleImage", fields: [imageFileId], references: [id], onDelete: SetNull)

  hardwareMappings ShopHardwareMapping[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([name])
  @@index([sku])
  @@index([category])
  @@index([supplierId])
  @@index([groupId])
  @@map("shop_articles")
}

model ShopHardwareMapping {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  variant String
  color   String

  articleId String?      @map("article_id") @db.Uuid
  article   ShopArticle? @relation(fields: [articleId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([variant, color])
  @@index([articleId])
  @@map("shop_hardware_mappings")
}

model TimeEntry {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  projectId String  @map("project_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  userId String? @map("user_id") @db.Uuid
  user   User?   @relation(fields: [userId], references: [id])

  // Die zulässigen Werte werden über settings-company.json gepflegt.
  // String statt Enum: neue Tätigkeiten benötigen keine DB-Migration mehr.
  workType String @map("work_type")

  customWorkType String? @map("custom_work_type")

  startedAt DateTime? @map("started_at")
  endedAt   DateTime? @map("ended_at")

  duration Int @default(0) // Minuten

  note String?

  createdAt DateTime @default(now()) @map("created_at")

  @@map("time_entries")
}

// Interne Betriebsrechnung. Keine steuerlichen Buchungen oder Kontenrahmen.
model ManagementPeriod {
  year      Int      @id
  config    Json
  revision  Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("management_periods")
}

model ManagementTransaction {
  id           String   @id @default(uuid()) @db.Uuid
  kind         String
  basis        String   @default("actual")
  source       String   @default("manual")
  sourceKey    String?  @unique @map("source_key")
  title        String
  counterparty String?
  date         DateTime @db.Date
  dueDate      DateTime? @map("due_date") @db.Date
  amount       Decimal  @db.Decimal(14, 2)
  vatRate      Decimal  @default(0) @map("vat_rate") @db.Decimal(5, 2)
  costTypeId   String?  @map("cost_type_id")
  centerId     String?  @map("center_id")
  note         String?
  projectId    String?  @map("project_id") @db.Uuid
  project      Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  fileId       String?  @map("file_id") @db.Uuid
  file         File?    @relation(fields: [fileId], references: [id], onDelete: SetNull)
  payments     ManagementPayment[]
  version      Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([date, basis])
  @@index([fileId])
  @@index([projectId])
  @@map("management_transactions")
}

model ManagementPayment {
  id            String @id @default(uuid()) @db.Uuid
  transactionId String @map("transaction_id") @db.Uuid
  transaction   ManagementTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  date          DateTime @db.Date
  amount        Decimal @db.Decimal(14, 2)
  note          String?

  @@index([transactionId])
  @@map("management_payments")
}

model ManagementAsset {
  id              String @id @default(uuid()) @db.Uuid
  name            String
  acquiredAt      DateTime @map("acquired_at") @db.Date
  purchaseCost    Decimal @map("purchase_cost") @db.Decimal(14, 2)
  residualValue   Decimal @default(0) @map("residual_value") @db.Decimal(14, 2)
  usefulLifeYears Decimal @map("useful_life_years") @db.Decimal(6, 2)
  centerId        String? @map("center_id")
  note            String?
  version         Int @default(0)

  @@map("management_assets")
}

model ManagementLoan {
  id          String @id @default(uuid()) @db.Uuid
  name        String
  startDate   DateTime @map("start_date") @db.Date
  principal   Decimal @db.Decimal(14, 2)
  interestRate Decimal @default(0) @map("interest_rate") @db.Decimal(5, 2)
  note        String?
  repayments  ManagementRepayment[]

  @@map("management_loans")
}

model ManagementRepayment {
  id     String @id @default(uuid()) @db.Uuid
  loanId String @map("loan_id") @db.Uuid
  loan   ManagementLoan @relation(fields: [loanId], references: [id], onDelete: Cascade)
  date   DateTime @db.Date
  amount Decimal @db.Decimal(14, 2)

  @@index([loanId])
  @@map("management_repayments")
}
