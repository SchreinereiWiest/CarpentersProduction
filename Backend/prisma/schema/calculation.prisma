model CalculationSnapshot {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String  @map("tenant_id") @db.Uuid
  projectId    String  @map("project_id") @db.Uuid
  releasedById String? @map("released_by") @db.Uuid

  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  releasedBy User?   @relation("CalculationSnapshotReleasedBy", fields: [releasedById], references: [id], onDelete: SetNull)

  schemaVersion Int     @default(1) @map("schema_version")
  sourceVersion Int     @map("source_version")
  projectTitle  String  @map("project_title")
  projectNumber String? @map("project_number")
  projectType   String? @map("project_type")
  description   String?
  filterText    String  @default("") @map("filter_text")

  cabinetCount  Int   @default(0) @map("cabinet_count")
  cabinetTypes  Int   @default(0) @map("cabinet_types")
  complexity    Float @default(0)
  volume        Float @default(0)
  materialCost  Float @default(0) @map("material_cost")
  plannedHours  Float @default(0) @map("planned_hours")
  actualHours   Float @default(0) @map("actual_hours")
  varianceHours Float @default(0) @map("variance_hours")

  plan             Json
  actual           Json
  hourlyRates      Json @map("hourly_rates")
  calculationBasis Json @map("calculation_basis")
  cabinetSummary   Json @map("cabinet_summary")
  listSummary      Json @map("list_summary")
  filterData       Json @map("filter_data")
  objectReferences Json @map("object_references")

  releasedAt DateTime @default(now()) @map("released_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([tenantId, id])
  @@unique([tenantId, projectId, sourceVersion])
  @@index([tenantId, releasedAt])
  @@index([tenantId, projectType, cabinetCount])
  @@index([projectId, releasedAt])
  @@map("calculation_snapshots")
}

