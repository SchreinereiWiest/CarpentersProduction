model Material {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  materialNumber String? @map("material_number")
  name           String  @map("name")
  manufacturer   String? @map("manufacturer")

  width Int @map("width")

  height Int @map("height")

  category String? @map("category")

  thickness Float? @map("thickness")

  pricePerSquareMeter Decimal? @map("price_per_square_meter") @db.Decimal(10, 2)

  edgeArticleNumber  String?  @map("edge_article_number")
  edgePricePerMeter  Decimal? @map("edge_price_per_meter") @db.Decimal(10, 2)
  edgePurchaseLength Float    @default(75) @map("edge_purchase_length")

  quantity Int? @map("quantity")

  minimumStorage Int? @map("minimum_storage")

  maser Boolean? @default(false) @map("maser")

  supplierId String?   @map("supplier_id") @db.Uuid
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, id])
  @@index([materialNumber])
  @@index([name])
  @@map("materials")
}

model ShopConfiguration {
  tenantId String @id @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  edgeWastePercentage Decimal @default(10) @map("edge_waste_percentage") @db.Decimal(6, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("shop_configurations")
}

model Supplier {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  name       String
  externalId String? @map("external_id")

  // Für spätere IDS-Connect-/E-Procurement-Adapter. Zugangsdaten gehören nicht in dieses JSON.
  procurementType   String? @map("procurement_type")
  procurementConfig Json?   @map("procurement_config")

  articles  ShopArticle[]
  materials Material[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, id])
  @@index([name])
  @@map("suppliers")
}

model ShopArticleGroup {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  name        String
  description String?
  articles    ShopArticle[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, id])
  @@index([name])
  @@map("shop_article_groups")
}

model ShopArticle {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  name        String
  sku         String?
  category    String?
  description String?
  unit        String  @default("Stk.")
  netPrice    Decimal @default(0) @map("net_price") @db.Decimal(12, 2)

  supplierId String?   @map("supplier_id") @db.Uuid
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  groupId String?           @map("group_id") @db.Uuid
  group   ShopArticleGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  imageFileId String? @map("image_file_id") @db.Uuid
  imageFile   File?   @relation("ShopArticleImage", fields: [imageFileId], references: [id], onDelete: SetNull)

  hardwareMappings ShopHardwareMapping[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, id])
  @@index([name])
  @@index([sku])
  @@index([category])
  @@index([supplierId])
  @@index([groupId])
  @@map("shop_articles")
}

model ShopHardwareMapping {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  variant String
  color   String

  articleId String?      @map("article_id") @db.Uuid
  article   ShopArticle? @relation(fields: [articleId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, variant, color])
  @@unique([tenantId, id])
  @@index([articleId])
  @@map("shop_hardware_mappings")
}
