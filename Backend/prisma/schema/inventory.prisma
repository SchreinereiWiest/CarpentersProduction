model Material {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  materialNumber String? @map("material_number")
  name           String  @map("name")
  manufacturer   String? @map("manufacturer")

  width Int @map("width")

  height Int @map("height")

  category String? @map("category")

  thickness Float? @map("thickness")

  pricePerSquareMeter Decimal? @map("price_per_square_meter") @db.Decimal(10, 2)

  edgeArticleNumber  String?  @map("edge_article_number")
  edgePricePerMeter  Decimal? @map("edge_price_per_meter") @db.Decimal(10, 2)
  edgePurchaseLength Float    @default(75) @map("edge_purchase_length")

  quantity Int? @map("quantity")

  minimumStorage Int? @map("minimum_storage")

  maser Boolean? @default(false) @map("maser")

  supplierId String?   @map("supplier_id") @db.Uuid
  supplier   Supplier? @relation("MaterialPlateSupplier", fields: [supplierId], references: [id], onDelete: SetNull)

  edgeSupplierId String?   @map("edge_supplier_id") @db.Uuid
  edgeSupplier   Supplier? @relation("MaterialEdgeSupplier", fields: [edgeSupplierId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, id])
  @@index([materialNumber])
  @@index([name])
  @@index([edgeSupplierId])
  @@map("materials")
}

model ShopConfiguration {
  tenantId String @id @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  edgeWastePercentage Decimal @default(10) @map("edge_waste_percentage") @db.Decimal(6, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("shop_configurations")
}

model Supplier {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  name       String
  externalId String? @map("external_id")

  // Für spätere IDS-Connect-/E-Procurement-Adapter. Zugangsdaten gehören nicht in dieses JSON.
  procurementType   String? @map("procurement_type")
  procurementConfig Json?   @map("procurement_config")

  articles               ShopArticle[]
  archivedArticleOptions ShopArticleArchive[]
  nonProjectPurchases    NonProjectPurchase[]
  materials              Material[]           @relation("MaterialPlateSupplier")
  edgeMaterials          Material[]           @relation("MaterialEdgeSupplier")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, id])
  @@index([name])
  @@map("suppliers")
}

model ShopArticleGroup {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  name        String
  description String?
  imageUrl    String? @map("image_url")
  articles    ShopArticle[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, id])
  @@index([name])
  @@map("shop_article_groups")
}

model ShopArticle {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  name        String
  sku         String?
  category    String?
  description String?
  unit        String  @default("Stk.")
  netPrice    Decimal @default(0) @map("net_price") @db.Decimal(12, 2)

  supplierId String?   @map("supplier_id") @db.Uuid
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  groupId String?           @map("group_id") @db.Uuid
  group   ShopArticleGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  imageFileId String? @map("image_file_id") @db.Uuid
  imageFile   File?   @relation("ShopArticleImage", fields: [imageFileId], references: [id], onDelete: SetNull)
  imageUrl    String? @map("image_url")

  hardwareMappings    ShopHardwareMapping[]
  purchaseListItems   PurchaseListItem[]
  archivedOptions     ShopArticleArchive[]
  nonProjectPurchases NonProjectPurchase[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, id])
  @@index([name])
  @@index([sku])
  @@index([category])
  @@index([supplierId])
  @@index([groupId])
  @@map("shop_articles")
}

model PurchaseList {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  name        String
  description String?
  category    String?
  items       PurchaseListItem[]
  purchases   NonProjectPurchase[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, id])
  @@index([name])
  @@index([category])
  @@map("purchase_lists")
}

model PurchaseListItem {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  listId    String       @map("list_id") @db.Uuid
  list      PurchaseList @relation(fields: [listId], references: [id], onDelete: Cascade)
  articleId String       @map("article_id") @db.Uuid
  article   ShopArticle  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  quantity  Decimal      @default(1) @db.Decimal(12, 3)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, listId, articleId])
  @@unique([tenantId, id])
  @@index([listId])
  @@index([articleId])
  @@map("purchase_list_items")
}

model ShopArticleArchive {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  articleId String      @map("article_id") @db.Uuid
  article   ShopArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  supplierId   String?   @map("supplier_id") @db.Uuid
  supplier     Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  supplierName String    @map("supplier_name")
  sku          String?
  netPrice     Decimal   @default(0) @map("net_price") @db.Decimal(12, 2)
  unit         String    @default("Stk.")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, id])
  @@index([articleId])
  @@index([supplierId])
  @@index([supplierName])
  @@index([sku])
  @@map("shop_article_archives")
}

model NonProjectPurchase {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  listId   String?       @map("list_id") @db.Uuid
  list     PurchaseList? @relation(fields: [listId], references: [id], onDelete: SetNull)
  listName String        @map("list_name")

  articleId    String?      @map("article_id") @db.Uuid
  article      ShopArticle? @relation(fields: [articleId], references: [id], onDelete: SetNull)
  name         String
  sku          String?
  category     String?
  description  String?
  quantity     Decimal      @db.Decimal(12, 3)
  unit         String
  netPrice     Decimal?     @map("net_price") @db.Decimal(12, 2)
  supplierId   String?      @map("supplier_id") @db.Uuid
  supplier     Supplier?    @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  supplierName String?      @map("supplier_name")

  status      String    @default("released")
  purchasedAt DateTime? @map("purchased_at")
  rejectedAt  DateTime? @map("rejected_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([tenantId, id])
  @@index([status])
  @@index([listId])
  @@index([articleId])
  @@index([supplierId])
  @@map("non_project_purchases")
}

model ShopHardwareMapping {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  variant String
  color   String

  articleId String?      @map("article_id") @db.Uuid
  article   ShopArticle? @relation(fields: [articleId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, variant, color])
  @@unique([tenantId, id])
  @@index([articleId])
  @@map("shop_hardware_mappings")
}
