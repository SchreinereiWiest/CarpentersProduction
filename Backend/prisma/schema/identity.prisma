enum UserRole {
  admin
  manager
  user
}

model Tenant {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name   String
  slug   String @unique
  status String @default("active")

  memberships                 TenantMembership[]
  license                     TenantLicense?
  syncMutations               SyncMutation[]
  shopConfiguration           ShopConfiguration?
  shopCatalogEntries          ShopCatalogEntry[]
  supplierCatalogArticles     SupplierCatalogArticle[]
  calculationSnapshots        CalculationSnapshot[]
  secrets                     TenantSecret[]
  calendarEvents              CalendarEvent[]
  paperlessConfiguration      PaperlessConfiguration?
  contactHistoryConfiguration ContactHistoryConfiguration?
  freePbxConfiguration        FreePbxConfiguration?
  phoneCalls                  PhoneCall[]
  onboarding                  TenantOnboarding?
  commissions                 Commission[]
  documentTemplates           DocumentTemplate[]
  commercialDocuments         CommercialDocument[]
  workAssignments             WorkAssignment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([name])
  @@map("tenants")
}

model TenantOnboarding {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @unique @map("tenant_id") @db.Uuid
  status         String    @default("pending")
  currentStep    String    @default("welcome") @map("current_step")
  completedSteps String[]  @default([]) @map("completed_steps")
  skippedSteps   String[]  @default([]) @map("skipped_steps")
  version        Int       @default(1)
  resetCount     Int       @default(0) @map("reset_count")
  startedById    String?   @map("started_by") @db.Uuid
  completedById  String?   @map("completed_by") @db.Uuid
  startedAt      DateTime  @default(now()) @map("started_at")
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@map("tenant_onboarding")
}

model TenantSecret {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  name       String
  ciphertext String
  iv         String
  authTag    String @map("auth_tag")
  keyVersion Int    @default(1) @map("key_version")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, name])
  @@unique([tenantId, id])
  @@map("tenant_secrets")
}

model TenantMembership {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  role        UserRole @default(user)
  isActive    Boolean  @default(true) @map("is_active")
  preferences Json     @default("{}")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("tenant_memberships")
}

model TenantLicense {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @unique @map("tenant_id") @db.Uuid
  licenseId      String    @unique @map("license_id")
  companyName    String    @map("company_name")
  plan           String
  features       String[]  @default([])
  maxUsers       Int?      @map("max_users")
  validUntil     DateTime? @map("valid_until")
  status         String    @default("active")
  licenseKeyHash String?   @map("license_key_hash")
  certificate    String?
  lastCheckedAt  DateTime? @map("last_checked_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("tenant_licenses")
}

model User {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  firstName String? @map("first_name")
  lastName  String? @map("last_name")
  email     String  @unique

  login        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole @default(user)
  isActive     Boolean  @default(true) @map("is_active")
  authVersion  Int      @default(0) @map("auth_version")

  customersCreated Customer[] @relation("CustomerCreatedBy")
  projectsCreated  Project[]  @relation("ProjectCreatedBy")

  communications               Communication[]
  appointments                 Appointment[]
  files                        File[]
  timeTable                    TimeEntry[]
  auditLogs                    AuditLog[]
  memberships                  TenantMembership[]
  releasedCalculationSnapshots CalculationSnapshot[]       @relation("CalculationSnapshotReleasedBy")
  tenantBackups                TenantBackup[]
  measurementPrintRuns         MeasurementPrintRun[]       @relation("MeasurementPrintRunCreatedBy")
  measurementScans             MeasurementScan[]           @relation("MeasurementScanUploadedBy")
  calendarEventsOwned          CalendarEvent[]             @relation("CalendarEventOwner")
  calendarEventsCreated        CalendarEvent[]             @relation("CalendarEventCreatedBy")
  managementAssignments        ManagementAssignment[]      @relation("ManagementAssignmentAssignee")
  managementAssignmentsCreated ManagementAssignment[]      @relation("ManagementAssignmentCreatedBy")
  managementAnnualGoalsCreated ManagementAnnualGoal[]      @relation("ManagementAnnualGoalCreatedBy")
  managementEmployeeProfiles   ManagementEmployeeProfile[]
  paperlessDocumentsLinked     PaperlessDocument[]
  paperlessDocumentsAssigned   PaperlessDocument[]         @relation("PaperlessDocumentAssignee")
  documentTemplatesUploaded    DocumentTemplate[]          @relation("DocumentTemplateUploadedBy")
  commercialDocumentsCreated   CommercialDocument[]        @relation("CommercialDocumentCreatedBy")
  commercialDocumentsAssigned  CommercialDocument[]        @relation("CommercialDocumentAssignee")
  workAssignmentsAssigned      WorkAssignment[]             @relation("WorkAssignmentAssignee")
  workAssignmentsCreated       WorkAssignment[]             @relation("WorkAssignmentCreatedBy")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("users")
}

model WorkAssignment {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  kind      String
  sourceId  String @map("source_id") @db.Uuid
  assigneeId String @map("assignee_id") @db.Uuid
  assignee   User   @relation("WorkAssignmentAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  createdById String @map("created_by") @db.Uuid
  createdBy   User   @relation("WorkAssignmentCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  title       String
  info        String?
  href        String
  status      String    @default("open")
  completedAt DateTime? @map("completed_at")
  dismissedAt DateTime? @map("dismissed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([tenantId, kind, sourceId, assigneeId])
  @@unique([tenantId, id])
  @@index([assigneeId, status, updatedAt])
  @@index([createdById, status, updatedAt])
  @@map("work_assignments")
}

model AuditLog {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  actorUserId String? @map("actor_user_id") @db.Uuid
  actorUser   User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  action     String
  entityType String  @map("entity_type")
  entityId   String? @map("entity_id")
  metadata   Json?
  ipAddress  String? @map("ip_address")
  userAgent  String? @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([tenantId, id])
  @@index([actorUserId])
  @@index([action, entityType])
  @@map("audit_logs")
}
