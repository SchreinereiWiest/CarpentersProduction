model StorageDeletionJob {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  bucketName String  @map("bucket_name")
  objectKey  String  @map("object_key")
  status     String  @default("pending")
  attempts   Int     @default(0)
  lastError  String? @map("last_error")

  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at")
  completedAt   DateTime? @map("completed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@unique([tenantId, bucketName, objectKey])
  @@unique([tenantId, id])
  @@index([status, nextAttemptAt])
  @@map("storage_deletion_jobs")
}

model TenantBackup {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  name       String
  backupType String @default("full") @map("backup_type")
  status     String @default("creating")
  objectKey  String? @map("object_key")
  bucketName String? @map("bucket_name")
  fileSize   BigInt? @map("file_size")
  checksum   String?
  fileCount  Int     @default(0) @map("file_count")
  tableCount Int     @default(0) @map("table_count")
  error      String?

  createdById String? @map("created_by") @db.Uuid
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt  DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")
  restoredAt DateTime? @map("restored_at")

  @@unique([tenantId, id])
  @@index([tenantId, createdAt])
  @@index([tenantId, backupType, createdAt])
  @@map("tenant_backups")
}

model S3Object {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  provider   String
  bucketName String @map("bucket_name")
  objectKey  String @map("object_key")

  region   String?
  endpoint String?

  accessUrl String? @map("access_url")
  etag      String?

  storageClass String? @map("storage_class")
  isArchived   Boolean @default(false) @map("is_archived")

  files          File[]
  projectStorage ProjectStorage[]

  uploadedAt DateTime @default(now()) @map("uploaded_at")

  @@unique([tenantId, id])
  @@map("s3_objects")
}

model File {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  customerId String? @map("customer_id") @db.Uuid
  projectId  String? @map("project_id") @db.Uuid

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  project  Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  storageObjectId String   @map("storage_object_id") @db.Uuid
  storageObject   S3Object @relation(fields: [storageObjectId], references: [id], onDelete: Cascade)

  fileName     String  @map("file_name")
  originalName String? @map("original_name")

  mimeType String? @map("mime_type")
  fileSize Int?    @map("file_size")

  category String?

  uploadedById String? @map("uploaded_by") @db.Uuid
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id])

  uploadedAt DateTime  @default(now()) @map("uploaded_at")
  deletedAt  DateTime? @map("deleted_at")

  status String? @map("status")

  // Monoton steigende, serverseitig vergebene Inhaltsversion. Sie wird fuer
  // optimistische Offline-Synchronisierung verwendet und ist bewusst kein
  // Zeitstempel.
  serverVersion Int      @default(1) @map("server_version")
  updatedAt     DateTime @updatedAt @map("updated_at")

  shopArticles           ShopArticle[]           @relation("ShopArticleImage")
  managementTransactions ManagementTransaction[]
  syncMutations          SyncMutation[]
  measurementScans       MeasurementScan[]

  @@unique([tenantId, id])
  @@map("files")
}

model MeasurementPrintRun {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  projectId String  @map("project_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdById String? @map("created_by") @db.Uuid
  createdBy   User?   @relation("MeasurementPrintRunCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  schemaVersion Int    @default(1) @map("schema_version")
  format        String @default("A4")
  orientation   String @default("landscape")
  sourceVersion Int?   @map("source_version")
  status        String @default("active")
  metadata      Json

  pages MeasurementPrintPage[]
  scans MeasurementScan[]

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([tenantId, id])
  @@index([projectId, createdAt])
  @@map("measurement_print_runs")
}

model MeasurementPrintPage {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  printRunId String              @map("print_run_id") @db.Uuid
  printRun   MeasurementPrintRun @relation(fields: [printRunId], references: [id], onDelete: Cascade)

  viewId     String @map("view_id")
  pageNumber Int    @map("page_number")
  label      String
  identifier String
  widthMm    Float  @map("width_mm")
  heightMm   Float  @map("height_mm")
  fields     Json
  metadata   Json?

  scans MeasurementScan[]

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([tenantId, id])
  @@unique([tenantId, identifier])
  @@unique([printRunId, pageNumber])
  @@index([printRunId])
  @@map("measurement_print_pages")
}

model MeasurementScan {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  fileId String @unique @map("file_id") @db.Uuid
  file   File   @relation(fields: [fileId], references: [id], onDelete: Cascade)

  printRunId  String?               @map("print_run_id") @db.Uuid
  printRun    MeasurementPrintRun?  @relation(fields: [printRunId], references: [id], onDelete: SetNull)
  printPageId String?               @map("print_page_id") @db.Uuid
  printPage   MeasurementPrintPage? @relation(fields: [printPageId], references: [id], onDelete: SetNull)
  projectId   String?               @map("project_id") @db.Uuid
  project     Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)

  uploadedById String? @map("uploaded_by") @db.Uuid
  uploadedBy   User?   @relation("MeasurementScanUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  status        String  @default("queued")
  rawIdentifier String? @map("raw_identifier")
  alignment     Json?
  result        Json?
  error         String?
  attempts      Int     @default(0)

  items MeasurementScanItem[]

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  completedAt DateTime? @map("completed_at")
  appliedAt   DateTime? @map("applied_at")

  @@unique([tenantId, id])
  @@index([projectId, createdAt])
  @@index([status, createdAt])
  @@map("measurement_scans")
}

model MeasurementScanItem {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  scanId String          @map("scan_id") @db.Uuid
  scan   MeasurementScan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  fieldId        String  @map("field_id")
  objectId       String  @map("object_id")
  viewId         String  @map("view_id")
  label          String?
  unit           String?
  rawText        String? @map("raw_text")
  predictedValue String? @map("predicted_value")
  confidence     Float?
  acceptedValue  String? @map("accepted_value")
  status         String  @default("pending")
  cropMetadata   Json?   @map("crop_metadata")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, id])
  @@unique([scanId, fieldId])
  @@index([scanId])
  @@map("measurement_scan_items")
}

model SyncMutation {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  idempotencyKey String   @map("idempotency_key")
  fileId         String?  @map("file_id") @db.Uuid
  file           File?    @relation(fields: [fileId], references: [id], onDelete: SetNull)
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  response       Json
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([tenantId, idempotencyKey])
  @@unique([tenantId, id])
  @@index([fileId])
  @@map("sync_mutations")
}

model ProjectStorage {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  projectId String  @map("project_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  storageObjectId String   @map("storage_object_id") @db.Uuid
  storageObject   S3Object @relation(fields: [storageObjectId], references: [id], onDelete: Cascade)

  dataType      String? @map("data_type")
  schemaVersion String? @map("schema_version")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([tenantId, id])
  @@map("project_storage")
}
