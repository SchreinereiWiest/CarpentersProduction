enum CustomerStatus {
  lead
  active
  inactive
}

model Customer {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String  @map("tenant_id") @db.Uuid
  customerNumber String? @map("customer_number")

  firstName   String? @map("first_name")
  lastName    String? @map("last_name")
  companyName String? @map("company_name")

  email         String?
  phoneMobile   String? @map("phone_mobile")
  phoneLandline String? @map("phone_landline")

  preferredContact String? @map("preferred_contact")

  newsletterOptIn   Boolean   @default(false) @map("newsletter_opt_in")
  newsletterOptInAt DateTime? @map("newsletter_opt_in_at")

  customerStatus CustomerStatus @default(active) @map("customer_status")
  customerRating Int            @default(0) @map("customer_rating") @db.SmallInt

  source String?
  notes  String?

  createdById String? @map("created_by") @db.Uuid
  createdBy   User?   @relation("CustomerCreatedBy", fields: [createdById], references: [id])

  projects       Project[]
  addresses      CustomerAddress[]
  communications Communication[]
  appointments   Appointment[]
  files              File[]
  paperlessDocuments PaperlessDocument[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([tenantId, id])
  @@unique([tenantId, customerNumber])
  @@map("customers")
}

model CustomerAddress {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  customerId String   @map("customer_id") @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  street      String?
  houseNumber String? @map("house_number")
  postalCode  String? @map("postal_code")
  city        String?
  country     String?

  floor             String?
  elevatorAvailable Boolean @default(false) @map("elevator_available")
  parkingInfo       String? @map("parking_info")

  appointments Appointment[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([tenantId, id])
  @@map("customer_addresses")
}

model Project {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  customerId String   @map("customer_id") @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  projectNumber String? @map("project_number")

  title       String
  description String?

  projectType String? @map("project_type")
  status      String  @default("inactive")
  priority    String  @default("normal")

  estimatedValue Float? @map("estimated_value")
  finalValue     Float? @map("final_value")

  startDate        DateTime? @map("start_date")
  installationDate DateTime? @map("installation_date")
  completionDate   DateTime? @map("completion_date")

  specialRequirements String? @map("special_requirements")
  customerNotes       String? @map("customer_notes")
  internalNotes       String? @map("internal_notes")

  createdById String? @map("created_by") @db.Uuid
  createdBy   User?   @relation("ProjectCreatedBy", fields: [createdById], references: [id])

  communications         Communication[]
  appointments           Appointment[]
  files                  File[]
  storage                ProjectStorage[]
  timeEntries            TimeEntry[]
  managementTransactions ManagementTransaction[]
  calculationSnapshots   CalculationSnapshot[]
  measurementPrintRuns   MeasurementPrintRun[]
  measurementScans       MeasurementScan[]
  calendarEvents         CalendarEvent[]
  paperlessDocuments     PaperlessDocument[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([tenantId, id])
  @@unique([tenantId, projectNumber])
  @@map("projects")
}

model Communication {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  customerId String  @map("customer_id") @db.Uuid
  projectId  String? @map("project_id") @db.Uuid

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  project  Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  type    String
  subject String?
  content String

  // Automatisch importierte E-Mails bleiben vom manuell erfassten Verlauf
  // unterscheidbar. Die externe ID ist nur zusammen mit Kunde und Quelle
  // eindeutig, weil dieselbe Nachricht mehrere bekannte Empfänger haben kann.
  source      String    @default("manual")
  externalId  String?   @map("external_id")
  messageId   String?   @map("message_id")
  direction   String?
  fromAddress String?   @map("from_address")
  toAddresses String[]  @default([]) @map("to_addresses")
  ccAddresses String[]  @default([]) @map("cc_addresses")
  occurredAt  DateTime? @map("occurred_at")
  attachments Json?

  followUpDate DateTime? @map("follow_up_date")

  createdById String? @map("created_by") @db.Uuid
  createdBy   User?   @relation(fields: [createdById], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([tenantId, id])
  @@unique([tenantId, customerId, source, externalId])
  @@index([customerId, occurredAt])
  @@map("communications")
}

model ContactHistoryConfiguration {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @unique @map("tenant_id") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  enabled             Boolean @default(false)
  host                String
  port                Int     @default(993)
  username            String
  accountEmail        String  @map("account_email")
  mailbox             String  @default("INBOX")
  initialSyncDays     Int     @default(90) @map("initial_sync_days")
  syncIntervalMinutes Int     @default(5) @map("sync_interval_minutes")

  uidValidity         String?   @map("uid_validity")
  lastUid             Int       @default(0) @map("last_uid")
  sentMailbox         String?   @map("sent_mailbox")
  sentUidValidity     String?   @map("sent_uid_validity")
  lastSentUid         Int       @default(0) @map("last_sent_uid")
  lastConnectedAt     DateTime? @map("last_connected_at")
  lastSyncAt          DateTime? @map("last_sync_at")
  lastSyncError       String?   @map("last_sync_error")
  consecutiveFailures Int       @default(0) @map("consecutive_failures")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, id])
  @@map("contact_history_configurations")
}

model Appointment {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  customerId String  @map("customer_id") @db.Uuid
  projectId  String? @map("project_id") @db.Uuid
  addressId  String? @map("address_id") @db.Uuid

  customer Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  project  Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  address  CustomerAddress? @relation(fields: [addressId], references: [id], onDelete: SetNull)

  appointmentType String? @map("appointment_type")
  title           String?
  description     String?

  startAt DateTime @map("start_at")
  endAt   DateTime @map("end_at")

  status String @default("planned")

  createdById String? @map("created_by") @db.Uuid
  createdBy   User?   @relation(fields: [createdById], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([tenantId, id])
  @@map("appointments")
}
