# Portable XilogConvert-Konfiguration. Relative Pfade werden vom Ordner dieser
# Datei aus aufgelöst. Gleichnamige Windows-Umgebungsvariablen haben Vorrang.

# Laufzeit: xISO liegt im veröffentlichten portablen Anwendungsordner.
XILOGCONVERT_XISO_PATH=.\xISO.exe
XILOGCONVERT_XISO_SHA256=131fd70a17ce4b05656b983d049e80d181d42a442a4baa04a082dcc85cdedba0

# Build: Quelle der proprietären xISO-Konsolenanwendung im Workspace.
XILOGCONVERT_BUILD_XISO_SOURCE=..\..\..\Xiso\xISO.exe

# Portable Einstellungen und Standardausgabe neben der Anwendung.
XILOGCONVERT_SETTINGS_PATH=.\settings.json
XILOGCONVERT_DEFAULT_OUTPUT_PATH=.\PGM
XILOGCONVERT_DEFAULT_EXPORT_MODE=files
XILOGCONVERT_DEFAULT_OVERWRITE=true

# Temporäre Konvertierungsdaten und Sicherheitsgrenzen.
XILOGCONVERT_TEMP_PATH=%TEMP%\XilogConvert
XILOGCONVERT_COMPILER_TIMEOUT_SECONDS=60
XILOGCONVERT_MAX_PROGRAMS=5000
XILOGCONVERT_MAX_UNPACKED_MB=250

