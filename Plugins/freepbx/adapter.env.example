# Beispiel der durch das FreePBX-Modul verwalteten Environment-Datei.
# Ablage: /var/lib/asterisk/carpenters/freepbx-adapter.env (0600)
# Lokale AMI-Verbindung. AMI_HOST bewusst nicht auf eine Netzwerk-IP ändern.
CARPENTERS_ENABLED="0"
AMI_HOST="127.0.0.1"
AMI_PORT="5038"
AMI_USERNAME="carpenters"
# Base64 erhält Sonderzeichen, ist aber keine Verschlüsselung.
AMI_PASSWORD_B64="CHANGE_ME_BASE64"

# Die drei vollständigen URLs aus
# Firmeneinstellungen -> Advanced -> Kontaktverlauf -> Telefonie.
CARPENTERS_RINGING_URL="https://carpenters.example.de/api/integrations/freepbx/webhook/TENANT_ID/ringing"
CARPENTERS_ANSWERED_URL="https://carpenters.example.de/api/integrations/freepbx/webhook/TENANT_ID/answered"
CARPENTERS_ENDED_URL="https://carpenters.example.de/api/integrations/freepbx/webhook/TENANT_ID/ended"
CARPENTERS_WEBHOOK_SECRET_B64="CHANGE_ME_BASE64"

# Typische eingehende FreePBX-Kontexte. Weitere Präfixe kommasepariert ergänzen.
INBOUND_CONTEXT_PREFIXES="from-trunk,from-pstn,from-did,ext-did"
HTTP_TIMEOUT_SECONDS="5"
LOG_LEVEL="INFO"
