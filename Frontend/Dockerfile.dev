# MkDocs configuration
COPY mkdocs.yml ./
COPY docs ./docs

# Generate static documentation
RUN mkdocs build --strict

# =========================================
# Stage 2: Non-Root Nginx
# =========================================

FROM nginxinc/nginx-unprivileged:alpine

# Nginx configuration
COPY --chown=33:33 docs-nginx.conf \
    /etc/nginx/conf.d/default.conf

# Built documentation
COPY --from=builder --chown=33:33 \
    /documentation/site/ \
    /usr/share/nginx/html/

# =========================================
# Security
# =========================================

USER 33:33

# =========================================
# Runtime
# =========================================

EXPOSE 8080

# Direkter Nginx-Start ohne Entrypoint-Skripte,
# die Konfigurationsdateien verändern könnten
ENTRYPOINT ["nginx", "-g", "daemon off;"]
