# Diese Datei nach .env kopieren und alle CHANGE_ME-Werte ersetzen.
NODE_ENV=development
POSTGRES_USER=carpenters
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=carpentersproduction

# Gemeinsames internes Secret für Backend und Measurement-OCR-Worker.
# Zum Beispiel mit `openssl rand -hex 32` erzeugen.
MEASUREMENT_OCR_SECRET=CHANGE_ME_RANDOM_64_HEX_CHARS
# Maximale Seitenzahl eines einzelnen Aufmaß-PDF-Uploads (1–100).
MEASUREMENT_OCR_MAX_PAGES=50
# Anzahl der ersten Paperless-Seiten, die auf Carpenters-QR-Codes geprüft werden.
PAPERLESS_QR_MAX_PAGES=5
# Pull-Fallback für verpasste oder im Development nicht erreichbare Webhooks.
PAPERLESS_SYNC_INTERVAL_MS=60000

# Dev-LAN-Zugriff für den Paperless-Webhook. Paperless muss diese IP erreichen
# können. In Production CARPENTERS_PUBLIC_URL auf die feste HTTPS-Domain setzen.
CARPENTERS_DEV_WEBHOOK_HOST=10.10.100.52
CARPENTERS_PUBLIC_URL=http://10.10.100.52
